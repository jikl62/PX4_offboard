+  // 位0..9依次对应原通用条件；bit6仍严格复用rc_live，不能用诊断细分放宽原来的准入规则。
+  static std::uint32_t queued_safety_mask(const Feedback& s) {
+    return (s.kill ? 1U : 0U) | (s.failsafe ? 2U : 0U) | (s.calibration ? 4U : 0U) |
