+           (!RcNavigationStart::rc_live(s) ? 64U : 0U) | (!s.rc_axes_safe ? 128U : 0U) |
+           (s.rc_sticks_moving ? 256U : 0U) | (!s.rc_aux_switches_safe ? 512U : 0U);
+  }
