+  struct QueuedSafetyEvidence {
+    bool recorded{};
+    std::uint32_t mask{};
+    SafetyEvent source{SafetyEvent::Status};
+    double observed_at{};
+    std::uint64_t status_stamp{}, land_stamp{}, local_stamp{}, switch_stamp{};
+  };
+  const QueuedSafetyEvidence& queued_safety_evidence() const {
