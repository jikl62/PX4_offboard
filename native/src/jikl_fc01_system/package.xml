<?xml version="1.0"?>
<!-- ROS 包元数据：声明构建与运行期依赖，本文件不会启动节点或打开飞行权限。 -->
<package format="3">
  <!-- 包名决定消息完整类型身份；保留版本和公开名称以兼容既有接口。 -->
  <name>jikl_fc01_system</name>
  <version>0.4.6</version>
  <description>FC01 ground, navigation, and gated attitude-altitude companion controller.</description>
  <maintainer email="jikl@example.invalid">jikl</maintainer>
  <license>MIT</license>
  <!-- ament 构建包，rosidl 生成五种本地消息；默认生成不代表视觉控制启用。 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <!-- C++ 主节点依赖；px4_msgs 必须由选定的 PX4 v1.16 SDK 提供。 -->
  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>builtin_interfaces</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <!-- 独立 Python 视觉适配/诊断所需：ROS 运行时、参数事件与原始 Odometry 类型。 -->
  <!-- exec_depend 供运行环境/rosdep 解析；nav_msgs 没有被加入 C++ 消息生成的构建依赖。 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <!-- 向 ROS 工具声明包的构建方式；安装与生命周期仍由外层脚本控制。 -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
